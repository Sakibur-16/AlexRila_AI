{
  "openapi": "3.1.0",
  "info": {
    "title": "Receipt Intelligence API",
    "description": "Receipt OCR and structured extraction.\n\nSubmit a receipt image, receive validated JSON. The response contract is stable\nand independent of which OCR engine produced it.\n\n**Monetary values are JSON strings** (`\"25.99\"`), not numbers, so that decimal\nprecision survives `JSON.parse`. Parse them into your own decimal type.\n\n**`success: true` means processed, not certain.** Check `warnings`,\n`data.confidence` and `data.review.review_required` before acting on a value.\n\n**Absent fields are `null`.** Never `\"N/A\"`, never `0`. A `null` means the\nreceipt did not carry that information.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness probe",
        "description": "Report that the process is alive. Never touches a dependency.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readiness probe",
        "description": "Report whether this instance can serve extraction requests.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Version information",
        "description": "Report the API, pipeline and schema versions in use.",
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/receipts/extract": {
      "post": {
        "tags": [
          "receipts"
        ],
        "summary": "Extract structured data from a receipt image",
        "description": "Extract structured data from a receipt image.\n\nReturns ``success: true`` whenever the document was processed, even when\nthe result is uncertain -- uncertainty is reported through ``warnings``,\n``data.confidence`` and ``data.review``, not through failure. Only an\nunusable input or an OCR failure produces ``success: false``.",
        "operationId": "extract_receipt_api_v1_receipts_extract_post",
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_receipt_api_v1_receipts_extract_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed. Check `warnings` and `data.confidence`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptExtractionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The upload was empty or unreadable."
          },
          "413": {
            "description": "The file exceeds the configured size limit."
          },
          "415": {
            "description": "The file is not a supported image type."
          },
          "422": {
            "description": "The image is too small to process."
          },
          "502": {
            "description": "OCR failed."
          },
          "503": {
            "description": "The configured OCR provider is unavailable."
          },
          "504": {
            "description": "OCR timed out."
          }
        }
      }
    }
  },
