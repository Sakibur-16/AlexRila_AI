# =============================================================================
# Receipt OCR -- example configuration
#
# Copy to .env and adjust. Every variable below is read by the application;
# nothing here is aspirational. Defaults shown are the built-in defaults, so an
# empty .env is a working development configuration.
#
# NEVER commit a real .env. Secrets belong in your platform's secret manager.
# =============================================================================

# --- application -------------------------------------------------------------
APP_ENV=development                 # development | staging | production | test
APP_NAME=receipt-ocr
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                     # json (production) | console (local)
# Echo structured error details to clients. Keep false in production.
DEBUG_ERRORS=false
# Comma-separated allowed origins. Empty disables CORS entirely.
CORS_ALLOW_ORIGINS=

# Bind address for `python -m app.main` (the development server only).
# Containers and process managers pass these on the uvicorn command line.
HOST=127.0.0.1
PORT=8000
RELOAD=false

# --- OCR provider ------------------------------------------------------------
# Registered providers: tesseract, fixture.
# "fixture" replays recorded OCR for tests and refuses to run in production.
OCR_PROVIDER=tesseract
OCR_TIMEOUT_SECONDS=30
OCR_MAX_RETRIES=2
OCR_RETRY_BASE_DELAY_SECONDS=0.25
# ISO 639-2/T codes, comma separated: eng,deu,fra,spa,ben,hin,ara
OCR_LANGUAGES=eng

# Tesseract specifics. Leave TESSERACT_CMD empty to resolve from PATH.
TESSERACT_CMD=
TESSERACT_TESSDATA_DIR=
TESSERACT_PSM=6                     # 6 = uniform block of text; best for receipts
TESSERACT_OEM=3
FIXTURE_OCR_DIR=tests/fixtures/receipts

# --- uploads -----------------------------------------------------------------
MAX_FILE_SIZE_MB=10
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=200
MAX_IMAGE_PIXELS=40000000           # decompression-bomb guard
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/tiff,image/bmp

# --- preprocessing -----------------------------------------------------------
# Each transform is applied only when measured quality says it will help.
# Over-processing degrades OCR, so SHARPEN and THRESHOLD default to off.
ENABLE_PREPROCESSING=true
PREPROCESS_GRAYSCALE=true
PREPROCESS_DESKEW=true
PREPROCESS_DENOISE=true
PREPROCESS_CONTRAST=true
PREPROCESS_SHARPEN=false
PREPROCESS_THRESHOLD=false
PREPROCESS_MIN_SHORT_EDGE=900
PREPROCESS_MAX_LONG_EDGE=3000
DESKEW_MIN_ANGLE_DEGREES=0.4
DESKEW_MAX_ANGLE_DEGREES=20

# --- image quality thresholds ------------------------------------------------
# Crossing one of these produces a warning, never a rejection.
QUALITY_MIN_BLUR_SCORE=60
QUALITY_MIN_BRIGHTNESS=45
QUALITY_MAX_BRIGHTNESS=225
QUALITY_MIN_CONTRAST=28

# --- locale ------------------------------------------------------------------
# DATE_ORDER resolves dates like 08/09/26. "none" means never guess: such dates
# come back as null with raw_date preserved and AMBIGUOUS_DATE_FORMAT raised.
# Set DMY or MDY only if you know where your receipts come from.
DATE_ORDER=none
# "auto" infers the decimal convention per document from all its amounts.
DECIMAL_SEPARATOR=auto
# Fallback ISO-4217 code when the document carries no currency evidence.
# Reported with low confidence because it is your assumption, not the receipt's.
DEFAULT_CURRENCY=
# ISO 3166-1 alpha-2. Resolves shared symbols: "$" plus DEFAULT_COUNTRY=CA -> CAD.
DEFAULT_COUNTRY=

# --- confidence --------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.85           # below this, the result is flagged for review
LOW_OCR_CONFIDENCE_THRESHOLD=0.60
REVIEW_FIELD_CONFIDENCE_THRESHOLD=0.65
# Blend of OCR legibility and extraction-method strength. Normalised at use.
CONFIDENCE_WEIGHT_OCR=0.45
CONFIDENCE_WEIGHT_EXTRACTION=0.55
CONFIDENCE_VALIDATION_PENALTY=0.65

# --- financial validation ----------------------------------------------------
# Permitted discrepancy = max(TOTAL_TOLERANCE, total * TOTAL_TOLERANCE_RATIO).
TOTAL_TOLERANCE=0.05
TOTAL_TOLERANCE_RATIO=0.01

# --- vision-model OCR (optional, OCR_PROVIDER=openai_vision) ------------------
# A multimodal model reads the receipt instead of Tesseract. Markedly more
# accurate on phone photos, crumpled paper and poor lighting; costs roughly
# $0.005 per receipt, adds 1-3s latency, and sends receipt images to the
# provider. Validation, confidence and redaction are unchanged either way.
# Known-good, vision-capable and cheap. Newer/more efficient models can be
# dropped in here without a code change -- confirm the exact name first with
#   python scripts/check_llm.py --list
VISION_MODEL=gpt-4o-mini
VISION_BASE_URL=                    # empty = the OpenAI API
VISION_API_KEY=                     # NEVER commit a real key
VISION_MAX_OUTPUT_TOKENS=4096

# --- review generation -------------------------------------------------------
# POST /api/v1/reviews/generate and /questions. Uses the LLM_* provider below.
REVIEW_ENABLED=true
REVIEW_TEMPERATURE=0.7              # prose benefits from variety; extraction stays at 0
REVIEW_MAX_OUTPUT_TOKENS=1024

# --- LLM fallback (optional) -------------------------------------------------
# Off by default. When enabled it runs only on low-confidence results, can only
# fill null or low-confidence fields, and its output is re-validated and
# checked against the OCR text before anything is accepted.
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini             # swap for a newer model any time; see check_llm.py
LLM_BASE_URL=
LLM_API_KEY=                        # NEVER commit a real key
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_FALLBACK_CONFIDENCE_THRESHOLD=0.75
LLM_MAX_INPUT_CHARS=20000

# --- privacy -----------------------------------------------------------------
INCLUDE_RAW_OCR=true                # full OCR text in the response
INCLUDE_EVIDENCE=false              # per-field source text and bounding boxes
ENABLE_RAW_OCR_STORAGE=false        # persist nothing by default
STORAGE_DIR=data/output
REDACT_SENSITIVE_TEXT=true          # mask card-like sequences before returning
LOG_DOCUMENT_CONTENT=false          # keep false in production: receipts are PII

# --- authentication ----------------------------------------------------------
# Shared secret clients must send as the X-API-Key header. LEAVE EMPTY for
# local development. SET IT before exposing the service to the internet --
# without it, anyone who finds the URL can submit unlimited images.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- limits ------------------------------------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
